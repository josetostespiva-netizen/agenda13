<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="agenda13.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Primary">#163F46</Color>
      <Color x:Key="Accent">#B78B45</Color>
      <Color x:Key="Muted">#52676A</Color>
      <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="#F5F3EE" /></Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="#183D43" /><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="15" />
      </Style>
      <Style x:Key="Heading" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="23" /></Style>
      <Style x:Key="Caption" TargetType="Label"><Setter Property="FontSize" Value="13" /><Setter Property="TextColor" Value="{StaticResource Muted}" /></Style>
      <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="#DFE5DF" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="Padding" Value="20" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="15" /><Setter Property="MinimumHeightRequest" Value="48" />
      </Style>
      <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#E7EDE8" /><Setter Property="TextColor" Value="{StaticResource Primary}" />
      </Style>
      <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource Primary}" /><Setter Property="TitleColor" Value="{StaticResource Muted}" /></Style>
      <Style TargetType="DatePicker"><Setter Property="TextColor" Value="{StaticResource Primary}" /></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
